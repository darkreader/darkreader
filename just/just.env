# Make sure this file is named just.env and is located next to the justfile

# --- Required Dependencies (update list as needed) ---
REQUIRED_DEPS="node npm"

# --- Required Env Variables (update list as needed) ---
REQUIRED_ENVS=""

# Firefox binary for inject/browser tests (Karma + Puppeteer).
# Override if Firefox is not on PATH (e.g. Developer Edition on macOS).
# FIREFOX_BIN="/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox"

# Set to 1 to include Safari in inject tests (macOS only; slow/optional).
# KARMA_SAFARI=1

# Browser integration test timeouts (ms). Default: 120000 (2 minutes).
# BROWSER_TEST_TIMEOUT_MS=120000

# Headless browser tests (also enabled automatically when CI=true).
# BROWSER_TEST_HEADLESS=1

# Reuse one browser across all test files in a Jest run (faster; opt-in). Default is per-file.
# BROWSER_TEST_REUSE_BROWSER=1

# Chrome binary for Puppeteer browser tests (optional; same idea as FIREFOX_BIN).
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
